# Copy to .env for local development. Never put real secrets in this example file.
# Do not set NODE_ENV here: Vite reads it while building and would bundle React's
# development runtime. The API defaults to development; production sets
# NODE_ENV=production in the process environment.
PORT=4000
APP_ORIGIN=http://localhost:5175
DATABASE_PATH=./data/sree.db

# Set to "true" only when serving the app over HTTPS.
COOKIE_SECURE=false

# Staff accounts are NOT created from the environment for email or name. Use
# `npm run admin:create -- --email you@example.com --name "Store Owner"`, which
# prompts for a password of at least 12 characters (letter + number), hashes it with
# bcrypt and never writes it to a file or log. Only this one variable is optional:
# ADMIN_PASSWORD lets you run the command non-interactively. Never commit it.
ADMIN_PASSWORD=
#
# Integrations below are NOT implemented in this build. They are read only to label
# capability in /api/v1/health and /api/v1/content/site, which report a key present
# without an adapter as "configured_no_adapter". Setting them enables nothing:
#  - online payment has no gateway adapter, so checkout always refuses with 503.
#  - courier booking and route-distance pricing have no adapters at all.
# Only SMTP (further down) has a working sender. Do not paste secrets into source code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
GOOGLE_ROUTES_API_KEY=

# Transactional email (optional). When both are set, placing an order writes
# invoice emails (customer + owner) to the order message log and sends them.
# SMTP_URL format: smtp://user:password@host:587  (or smtps://host:465)
# URL-encode special characters in the password. SMTP_FROM must be the verified
# sender address, e.g. "Sree Collections <orders@yourdomain.com>".
# Invoice links use APP_ORIGIN, so set it to the public site origin in production.
SMTP_URL=
SMTP_FROM=

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "src", "tests"]
}
